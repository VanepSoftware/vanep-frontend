# Base URL do backend Vanep (Spring Authorization Server), SEM sufixo /api.
# Dev: http://localhost:8080
AUTH_URL=http://localhost:8080

# Cliente OAuth confidencial registrado no backend (PKCE + client_secret).
# Deve bater com VANEP_OAUTH_CLIENT_ID no vanep-api-java.
AUTH_OAUTH_CLIENT_ID=vanep-frontend

# Segredo do cliente OAuth. Obrigatório: o Spring Authorization Server só emite refresh token
# para cliente que se autentica, então sem ele a sessão do admin morre ao fim do TTL do access
# token (15 min) e não tem como renovar. Deve bater com VANEP_OAUTH_CLIENT_SECRET no backend.
AUTH_OAUTH_CLIENT_SECRET=

# Segredo para assinar o JWT de sessão do NextAuth: openssl rand -base64 32
AUTH_SECRET=

# URL pública deste frontend (NextAuth). O callback é ${NEXTAUTH_URL}/api/auth/callback/vanep,
# que precisa estar nos redirect URIs do cliente no backend (VANEP_OAUTH_REDIRECT_URIS).
NEXTAUTH_URL=http://localhost:3000

# Perfil publico da Vanep no Instagram, exibido no rodape do site.
VANEP_INSTAGRAM_URL=https://instagram.com/vanepteam

# Base do GitHub, usada para montar os perfis da equipe no rodape.
VANEP_GITHUB_BASE_URL=https://github.com
